{
  "name": "blue-vs-red-roblox",
  "version": "0.2.0",
  "description": "BLUE vs RED - Three Flags Domination. A Roblox combined-arms military game (Rojo project).",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:map": "node Tools/gen_map.mjs",
    "gen:models": "python3 BlenderProjects/Scripts/build_all.py",
    "gen:voice": "python3 Tools/audio/gen_voice.py",
    "gen:audio": "python3 Tools/audio/build_audio.py",
    "build": "rojo build default.project.json -o Build/BlueVsRed.rbxl",
    "test": "lune run Tests/run",
    "check": "bash Tools/check.sh"
  }
}
