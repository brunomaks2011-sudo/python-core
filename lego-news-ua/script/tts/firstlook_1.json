{"tts": "І новий подарунковий набір сорок дев'ятсот чотирнадцять — Ретро-музичний автомат на двісті вісімдесят сім деталей. Умови, за яких його можна буде отримати, поки невідомі.", "words": [{"text": "І", "start": 0.097166, "end": 0.226874}, {"text": "новий", "start": 0.26225, "end": 0.509875}, {"text": "подарунковий", "start": 0.568875, "end": 1.146708}, {"text": "набір", "start": 1.193875, "end": 1.500458}, {"text": "сорок", "start": 1.559416, "end": 1.865999}, {"text": "дев'ятсот", "start": 1.936791, "end": 2.373124}, {"text": "чотирнадцять", "start": 2.396708, "end": 3.080666}, {"text": "Ретро-музичний", "start": 3.328291, "end": 4.035832}, {"text": "автомат", "start": 4.071208, "end": 4.507541}, {"text": "на", "start": 4.578291, "end": 4.696207}, {"text": "двісті", "start": 4.755208, "end": 5.108999}, {"text": "вісімдесят", "start": 5.132541, "end": 5.745749}, {"text": "сім", "start": 5.781125, "end": 5.922625}, {"text": "деталей", "start": 6.005208, "end": 6.476916}, {"text": "Умови", "start": 7.323125, "end": 7.853791}, {"text": "за", "start": 8.018875, "end": 8.172166}, {"text": "яких", "start": 8.19575, "end": 8.490541}, {"text": "його", "start": 8.525958, "end": 8.738208}, {"text": "можна", "start": 8.785375, "end": 9.068375}, {"text": "буде", "start": 9.139166, "end": 9.280666}, {"text": "отримати", "start": 9.339625, "end": 9.893875}, {"text": "поки", "start": 10.094333, "end": 10.306583}, {"text": "невідомі", "start": 10.353791, "end": 10.872666}]}