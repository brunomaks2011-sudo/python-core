[
{
"text": "Привіт, друзі!",
"start": 2.297,
"end": 4.424
},
{
"text": "Це LEGO NEWS UA",
"start": 4.444,
"end": 5.494
},
{
"text": "— найцікавіші новини світу LEGO за останній тиждень!",
"start": 5.514,
"end": 8.936
},
{
"text": "Сьогодні поговоримо про нові набори,",
"start": 9.967,
"end": 11.938
},
{
"text": "цікаві витоки, майбутні релізи та несподівані мініфігурки!",
"start": 11.958,
"end": 15.724
},
{
"text": "Починаємо!",
"start": 15.744,
"end": 17.632
},
{
"text": "Блок перший —",
"start": 20.643,
"end": 21.703
},
{
"text": "головні новини тижня.",
"start": 21.723,
"end": 23.334
},
{
"text": "Тиждень видався гарячим!",
"start": 25.251,
"end": 27.665
},
{
"text": "LEGO офіційно представила найбільший набір в історії LEGO",
"start": 27.685,
"end": 30.814
},
{
"text": "Ideas — Ґодзілу.",
"start": 30.834,
"end": 32.574
},
{
"text": "Китайський Новий рік 2027 отримує одразу три новинки,",
"start": 33.641,
"end": 36.977
},
{
"text": "Ninjago показує величезне додзьо,",
"start": 36.997,
"end": 39.632
},
{
"text": "а Fortnite —",
"start": 39.652,
"end": 40.735
},
{
"text": "двох дуже дивакуватих героїв.",
"start": 40.755,
"end": 43.349
},
{
"text": "Усі новини та фотографії",
"start": 44.431,
"end": 45.884
},
{
"text": "— з Telegram-каналу The Stud Ledger.",
"start": 45.904,
"end": 48.231
},
{
"text": "Головна офіційна новина тижня",
"start": 50.191,
"end": 53.3
},
{
"text": "— LEGO Ideas 21375,",
"start": 53.32,
"end": 54.967
},
{
"text": "Ґодзіла!",
"start": 54.987,
"end": 56.29
},
{
"text": "5363 деталі —",
"start": 57.357,
"end": 58.524
},
{
"text": "це найбільший набір в історії LEGO Ideas.",
"start": 58.544,
"end": 62.169
},
{
"text": "Ціна — 400 євро,",
"start": 62.189,
"end": 65.195
},
{
"text": "вихід — 27 листопада.",
"start": 65.215,
"end": 67.439
},
{
"text": "Сірий панцир, сяючі блакитні спинні пластини та атомний",
"start": 68.507,
"end": 71.775
},
{
"text": "промінь — король монстрів виглядає по-справжньому грізно.",
"start": 71.795,
"end": 75.278
},
{
"text": "До Ґодзіли буде подарунковий набір 40888",
"start": 77.219,
"end": 80.646
},
{
"text": "— логотип Ґодзіли зі слідом лапи на 359",
"start": 80.666,
"end": 84.379
},
{
"text": "деталей.",
"start": 84.399,
"end": 85.37
},
{
"text": "Його також чекаємо 27 листопада.",
"start": 86.449,
"end": 89.293
},
{
"text": "Блок другий —",
"start": 92.301,
"end": 93.367
},
{
"text": "нові набори та свіжі фотографії.",
"start": 93.387,
"end": 95.558
},
{
"text": "LEGO Ninjago 71888",
"start": 97.485,
"end": 99.948
},
{
"text": "— Додзьо Іво.",
"start": 99.968,
"end": 102.882
},
{
"text": "3495 деталей, ціна",
"start": 102.902,
"end": 105.105
},
{
"text": "— 280 євро,",
"start": 105.125,
"end": 107.052
},
{
"text": "вихід — 1 січня 2027 року.",
"start": 107.072,
"end": 111.081
},
{
"text": "Це величезна будівля з вежею,",
"start": 112.163,
"end": 114.102
},
{
"text": "кількома поверхами, транспортом і цілою командою мініфігурок.",
"start": 114.122,
"end": 117.944
},
{
"text": "Офіційного анонсу ще не було,",
"start": 119.017,
"end": 120.776
},
{
"text": "тож поки це витік.",
"start": 120.796,
"end": 122.333
},
{
"text": "Для Китайського Нового року 2027 готують справжнє свято.",
"start": 124.249,
"end": 129.797
},
{
"text": "80123 — Подорож на весняне свято.",
"start": 129.817,
"end": 133.117
},
{
"text": "1529 деталей, 100 євро,",
"start": 134.223,
"end": 135.938
},
{
"text": "вихід — 1 січня 2027 року.",
"start": 135.958,
"end": 138.957
},
{
"text": "Яскравий корабель із головою дракона,",
"start": 138.977,
"end": 142.874
},
{
"text": "великим вітрилом і купою мініфігурок.",
"start": 142.894,
"end": 146.581
},
{
"text": "80122 — Сприятлива Піксіу під деревом Щастя:",
"start": 148.503,
"end": 153.164
},
{
"text": "70 євро, вихід",
"start": 153.184,
"end": 155.186
},
{
"text": "— 1 січня 2027 року.",
"start": 155.206,
"end": 157.291
},
{
"text": "Але тут є розбіжність:",
"start": 158.381,
"end": 160.288
},
{
"text": "у дописі вказано 829 деталей,",
"start": 160.308,
"end": 162.507
},
{
"text": "а на фото коробки",
"start": 162.527,
"end": 164.23
},
{
"text": "— 879.",
"start": 164.25,
"end": 164.754
},
{
"text": "Остаточну цифру ще варто перевірити.",
"start": 164.774,
"end": 168.805
},
{
"text": "LEGO Botanicals готує квіткову весну.",
"start": 170.765,
"end": 174.516
},
{
"text": "The Stud Ledger опублікував зображення чотирьох нових наборів,",
"start": 174.536,
"end": 179.02
},
{
"text": "вихід — січень–лютий 2027 року.",
"start": 179.04,
"end": 181.26
},
{
"text": "Пастельний букет —",
"start": 182.347,
"end": 183.998
},
{
"text": "650 деталей, букет півоній",
"start": 184.018,
"end": 186.607
},
{
"text": "— 633, дика орхідея",
"start": 186.627,
"end": 188.752
},
{
"text": "— 606, а гілки сакури",
"start": 188.772,
"end": 190.998
},
{
"text": "— 405 деталей.",
"start": 191.018,
"end": 192.479
},
{
"text": "Цін поки немає.",
"start": 193.545,
"end": 194.892
},
{
"text": "Ще кілька перших поглядів.",
"start": 196.833,
"end": 200.228
},
{
"text": "LEGO Technic 42254",
"start": 200.248,
"end": 201.644
},
{
"text": "— Планети Сонячної системи на орбіті,",
"start": 201.664,
"end": 205.157
},
{
"text": "572 деталі.",
"start": 205.177,
"end": 206.467
},
{
"text": "І новий подарунковий набір 40914",
"start": 207.527,
"end": 209.734
},
{
"text": "— Ретро-музичний автомат на 287 деталей.",
"start": 209.754,
"end": 212.817
},
{
"text": "Умови, за яких його можна буде отримати,",
"start": 212.837,
"end": 216.994
},
{
"text": "поки невідомі.",
"start": 217.014,
"end": 218.553
},
{
"text": "Блок третій —",
"start": 221.563,
"end": 223.258
},
{
"text": "LEGO Leaks 2027!",
"start": 223.278,
"end": 224.95
},
{
"text": "Почнемо з LEGO 67005",
"start": 226.891,
"end": 228.352
},
{
"text": "— Дивний Верховний Санктум!",
"start": 228.372,
"end": 230.35
},
{
"text": "За інформацією з витоку,",
"start": 230.37,
"end": 233.155
},
{
"text": "набір матиме 814 деталей,",
"start": 233.175,
"end": 235.071
},
{
"text": "а його очікувана ціна становитиме 100 євро.",
"start": 235.091,
"end": 238.707
},
{
"text": "Реліз запланований на 1 січня 2027 року.",
"start": 239.793,
"end": 243.958
},
{
"text": "Але найбільше уваги привертають мініфігурки!",
"start": 245.889,
"end": 248.426
},
{
"text": "У наборі очікуються Злий Доктор Стрендж,",
"start": 248.446,
"end": 251.551
},
{
"text": "Залізна Людина, Людина-павук,",
"start": 251.571,
"end": 253.727
},
{
"text": "Зомбі Ванда, Немор та Зомбі Тор!",
"start": 253.747,
"end": 256.396
},
{
"text": "Одразу шість цікавих персонажів!",
"start": 257.519,
"end": 259.821
},
{
"text": "Уточнення: у ранньому списку The Stud Ledger Залізна",
"start": 260.917,
"end": 264.053
},
{
"text": "Людина та Немор позначені як зомбі,",
"start": 264.073,
"end": 266.143
},
{
"text": "а Стрендж —",
"start": 266.163,
"end": 267.208
},
{
"text": "як Дивний Верховний.",
"start": 267.228,
"end": 269.208
},
{
"text": "Остаточний склад покаже офіційний анонс.",
"start": 269.228,
"end": 271.895
},
{
"text": "Наступний цікавий витік",
"start": 273.805,
"end": 276.011
},
{
"text": "— LEGO 77088,",
"start": 276.031,
"end": 277.07
},
{
"text": "Такос Гуакос!",
"start": 277.09,
"end": 278.54
},
{
"text": "За попередньою інформацією,",
"start": 278.56,
"end": 281.925
},
{
"text": "набір матиме 193 деталі,",
"start": 281.945,
"end": 284.094
},
{
"text": "коштуватиме 20 євро,",
"start": 284.114,
"end": 285.866
},
{
"text": "а його вихід очікується 1 січня 2027 року.",
"start": 285.886,
"end": 289.5
},
{
"text": "Тако з величезними очима відкривається,",
"start": 290.571,
"end": 292.601
},
{
"text": "а всередині —",
"start": 292.621,
"end": 293.738
},
{
"text": "маленька сцена з мініфігуркою.",
"start": 293.758,
"end": 295.845
},
{
"text": "А тепер LEGO 77084",
"start": 297.771,
"end": 299.354
},
{
"text": "— P-1000!",
"start": 299.374,
"end": 300.092
},
{
"text": "За інформацією з витоку,",
"start": 300.112,
"end": 303.414
},
{
"text": "набір складатиметься з 1103 деталей,",
"start": 303.434,
"end": 306.52
},
{
"text": "а його очікувана ціна становитиме 90 євро.",
"start": 306.54,
"end": 311.222
},
{
"text": "Дата виходу —",
"start": 311.242,
"end": 312.631
},
{
"text": "1 січня 2027 року.",
"start": 312.651,
"end": 314.351
},
{
"text": "Високий жовтий робот на підставці з табличкою,",
"start": 315.449,
"end": 318.085
},
{
"text": "а поруч —",
"start": 318.105,
"end": 319.087
},
{
"text": "мініфігурка, яку канал показав окремо.",
"start": 319.107,
"end": 322.102
},
{
"text": "І ще одна цікава новинка",
"start": 324.017,
"end": 326.432
},
{
"text": "— LEGO 40976,",
"start": 326.452,
"end": 327.504
},
{
"text": "Лев процвітання!",
"start": 327.524,
"end": 330.025
},
{
"text": "За попередніми даними,",
"start": 330.045,
"end": 331.946
},
{
"text": "набір міститиме 411 деталей,",
"start": 331.966,
"end": 334.396
},
{
"text": "коштуватиме 30 євро,",
"start": 334.416,
"end": 336.173
},
{
"text": "а його реліз очікується 1 січня 2027 року.",
"start": 336.193,
"end": 339.807
},
{
"text": "Червоно-золотий лев для традиційного танцю левів",
"start": 340.879,
"end": 343.472
},
{
"text": "— ідеальний символ свята.",
"start": 343.492,
"end": 345.374
},
{
"text": "Блок четвертий —",
"start": 348.411,
"end": 349.658
},
{
"text": "цікаві деталі та мініфігурки.",
"start": 349.678,
"end": 351.668
},
{
"text": "Перший погляд на торс Червоного Павука з набору",
"start": 353.619,
"end": 357.029
},
{
"text": "67002, Мех Червоного Павука.",
"start": 357.049,
"end": 359.695
},
{
"text": "Але увага: на цьому зразку міспринт",
"start": 360.761,
"end": 362.986
},
{
"text": "— білої частини на фінальній фігурці не буде.",
"start": 363.006,
"end": 365.964
},
{
"text": "А ще погляньте на мініфігурки Додзьо Іво",
"start": 367.889,
"end": 370.213
},
{
"text": "— ціла команда ніндзя та їхніх суперників.",
"start": 370.233,
"end": 373.151
},
{
"text": "І на маленьку мініфігурку з P-1000,",
"start": 374.215,
"end": 376.238
},
{
"text": "яку канал показав окремо.",
"start": 376.258,
"end": 378.427
},
{
"text": "Блок п'ятий —",
"start": 381.435,
"end": 382.511
},
{
"text": "що чекає нас далі.",
"start": 382.531,
"end": 383.89
},
{
"text": "Січень 2027 обіцяє бути насиченим:",
"start": 385.851,
"end": 388.133
},
{
"text": "Marvel, Fortnite, Ninjago,",
"start": 388.153,
"end": 390.834
},
{
"text": "Китайський Новий рік і Botanicals.",
"start": 390.854,
"end": 393.908
},
{
"text": "За ранніми даними The Stud Ledger,",
"start": 394.961,
"end": 398.227
},
{
"text": "хвиля Marvel включає набори від 67001 до 67005,",
"start": 398.247,
"end": 402.434
},
{
"text": "збірний логотип Людини-павука 67022 та Джеффа Земляну Акулу",
"start": 402.454,
"end": 407.581
},
{
"text": "67023.",
"start": 407.601,
"end": 408.501
},
{
"text": "Для більшості з них фото ще немає,",
"start": 409.471,
"end": 411.486
},
{
"text": "тож поки це на рівні чуток.",
"start": 411.506,
"end": 413.229
},
{
"text": "Стежимо далі!",
"start": 413.249,
"end": 415.332
},
{
"text": "А яка новина цього тижня сподобалася вам найбільше?",
"start": 417.271,
"end": 420.008
},
{
"text": "Який із майбутніх наборів ви хотіли б придбати?",
"start": 420.028,
"end": 423.532
},
{
"text": "Напишіть у коментарях!",
"start": 423.552,
"end": 426.115
},
{
"text": "Підписуйтеся на LEGO NEWS UA,",
"start": 427.173,
"end": 428.91
},
{
"text": "щоб не пропускати найцікавіші новини LEGO!",
"start": 428.93,
"end": 431.492
},
{
"text": "До зустрічі наступного тижня!",
"start": 431.512,
"end": 434.269
}
]