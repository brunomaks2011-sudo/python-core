# Caddy автоматично отримує та оновлює сертифікат Let's Encrypt для {$DOMAIN}
# і перенаправляє http:// → https:// (308).
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# Обмеження розміру запиту (завантаження зображень в адмінці)
	request_body {
		max_size 12MB
	}

	reverse_proxy app:3000
}
