# =====================================================================
#  «Цеглинка» — змінні середовища
#  Скопіюйте цей файл у .env і заповніть значення.
#  НІКОЛИ не комітьте .env у репозиторій.
# =====================================================================

# ---------- База даних ----------
# Рядок підключення до PostgreSQL. Для локального запуску через
# docker compose (див. docker-compose.yml) підійде значення нижче.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop?schema=public"

# Параметри контейнера PostgreSQL (використовуються docker-compose*.yml)
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# ---------- Сайт ----------
# Публічна адреса сайту без «/» в кінці. Використовується для SEO
# (canonical, sitemap, Open Graph) та для посилань LiqPay (result_url, server_url).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Авторизація (Auth.js) ----------
# Секрет для підпису сесій. Згенеруйте: openssl rand -base64 32
AUTH_SECRET=""
# Довіряти заголовку Host (потрібно за reverse-proxy, наприклад Caddy).
# На Vercel можна не задавати.
AUTH_TRUST_HOST=true

# ---------- Обліковий запис адміністратора (для seed-скрипта) ----------
# Seed створить (або оновить) користувача з роллю ADMIN.
ADMIN_EMAIL="admin@example.com"
# Мінімум 8 символів. Обов'язково змініть!
ADMIN_PASSWORD=""
ADMIN_NAME="Адміністратор"

# ---------- LiqPay ----------
# Ключі: https://www.liqpay.ua/ → Кабінет → Налаштування → API.
# Якщо ключі не задані, оплата карткою буде недоступна (лишиться накладений платіж).
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
# 1 — тестовий режим (sandbox, гроші не списуються), 0 — бойовий режим.
LIQPAY_SANDBOX=1

# ---------- Нова Пошта ----------
# API-ключ: особистий кабінет Нової Пошти → Налаштування → Безпека → API-ключі.
# Якщо ключ порожній — пошук міст/відділень вводиться вручну, а вартість
# доставки рахується за резервними тарифами (див. нижче / адмінка → Налаштування).
NOVA_POSHTA_API_KEY=""
# Ref міста відправника (за замовчуванням — Київ).
NOVA_POSHTA_SENDER_CITY_REF="8d5a980d-391c-11dd-90d9-001a92567626"

# ---------- Доставка: значення за замовчуванням (у гривнях) ----------
# Використовуються, доки в адмінці (Налаштування) не збережено інші значення.
FREE_SHIPPING_THRESHOLD_UAH=2000
UKRPOSHTA_RATE_UAH=60
NP_FALLBACK_WAREHOUSE_RATE_UAH=80
NP_FALLBACK_COURIER_RATE_UAH=120
# Адреса пункту самовивозу (показується покупцю)
PICKUP_ADDRESS="м. Київ, вул. Хрещатик, 1 (щодня 10:00–20:00)"

# ---------- Пошта (SMTP) ----------
# Для листів відновлення пароля та підтвердження замовлення.
# Якщо SMTP_HOST порожній — листи виводяться в консоль сервера.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Цеглинка <no-reply@example.com>"

# ---------- Завантаження зображень ----------
# Локальна папка для зображень товарів (VPS/Docker). Файли віддаються за адресою /uploads/...
UPLOAD_DIR="./uploads"
# На Vercel файлова система лише для читання — задайте токен Vercel Blob,
# і зображення зберігатимуться там (Storage → Blob → токен створиться автоматично).
BLOB_READ_WRITE_TOKEN=""

# ---------- Розгортання на VPS (Caddy) ----------
# Домен, для якого Caddy автоматично отримає сертифікат Let's Encrypt.
DOMAIN="shop.example.com"
# Email для повідомлень Let's Encrypt.
ACME_EMAIL="admin@example.com"
