# Copy to .env and fill in. Never commit .env: it contains secrets.

# ---------------------------------------------------------------- Telegram
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids. Admins control the bot (emergency stop, run mode, Gift Wiki sync).
ADMIN_USER_IDS=
# Other users allowed to use the bot (notifications, search, own filters). Empty = admins only.
ALLOWED_USER_IDS=
# Users allowed to buy (the single MRKT account below is used). Empty = admins only.
PURCHASE_USER_IDS=

# ---------------------------------------------------------------- Safety
# notify_only | dry_run | live. dry_run = test mode: shows what would be bought, sends no buy requests.
RUN_MODE=dry_run
# Time zone used for daily limits
TIMEZONE=UTC

# ---------------------------------------------------------------- Storage (docker-compose fills DATABASE_URL/REDIS_URL)
POSTGRES_DB=sniper
POSTGRES_USER=sniper
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+asyncpg://sniper:change-me@localhost:5432/sniper
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=sniper

# ---------------------------------------------------------------- MRKT (unofficial Mini App API, see docs/DATA_SOURCES.md)
MRKT_API_BASE_URL=https://api.tgmrkt.io/api/v1
# Access token of YOUR MRKT account (response of POST /auth in the Mini App). The bot never asks for
# your Telegram password or login code.
MRKT_ACCESS_TOKEN=
# Optional: Telegram WebApp initData of the MRKT Mini App; used to obtain a token via POST /auth.
MRKT_INIT_DATA=
# raw -> "Authorization: <token>", bearer -> "Authorization: Bearer <token>"
MRKT_AUTH_HEADER_FORMAT=raw
MRKT_REQUESTS_PER_SECOND=2
MRKT_PRIORITY_REQUESTS_PER_SECOND=2
MRKT_REQUEST_TIMEOUT_SECONDS=10
MRKT_BUY_TIMEOUT_SECONDS=15
MRKT_MONITOR_ENABLED=true
# feed (POST /feed) | saling (POST /gifts/saling sorted by listing time)
MRKT_MONITOR_SOURCE=feed
MRKT_FEED_POLL_INTERVAL_SECONDS=2
MRKT_FEED_PAGE_SIZE=20
MRKT_FEED_MAX_PAGES=5
MRKT_APP_URL=https://t.me/mrkt/app
# Optional deep-link template for a listing, e.g. with {gift_id}, {slug}, {number}. Empty = MRKT_APP_URL.
MRKT_LISTING_URL_TEMPLATE=

# ---------------------------------------------------------------- Gift Wiki (api.giftwiki.tg)
GIFTWIKI_API_BASE_URL=https://api.giftwiki.tg
# Dev API key with collection:read scope (sent as X-API-Key)
GIFTWIKI_API_KEY=
GIFTWIKI_REQUESTS_PER_SECOND=1
GIFTWIKI_REQUEST_TIMEOUT_SECONDS=20
GIFTWIKI_SYNC_INTERVAL_MINUTES=360
GIFTWIKI_MAX_PAGES=2000
# Request every gift with gift_name=... to get its complete record list (needed for NOT_MONOCHROME)
GIFTWIKI_PER_GIFT_LOOKUP=true
# Absent pairs become UNKNOWN when the gift's data is older than this
GIFTWIKI_STALE_AFTER_HOURS=24
GIFTWIKI_PUBLIC_URL=https://t.me/giftwiki

# ---------------------------------------------------------------- Monochrome classification
# not_monochrome: a pair missing from a COMPLETE Gift Wiki list of the gift is NOT_MONOCHROME; unknown: UNKNOWN
MONOCHROME_ABSENT_PAIR_POLICY=not_monochrome
MONOCHROME_AUTOBUY_MAX_DATA_AGE_HOURS=72
# Compare backdrop colors of MRKT and Gift Wiki records; a mismatch gives UNKNOWN
MONOCHROME_COLOR_CHECK=true

# ---------------------------------------------------------------- Purchases
PURCHASE_LOCK_TTL_SECONDS=120
# The listing is re-fetched right before buying; the snapshot must be younger than this
PURCHASE_MAX_SNAPSHOT_AGE_SECONDS=5
PURCHASE_VERIFY_ATTEMPTS=5
PURCHASE_VERIFY_DELAY_SECONDS=2
# Retries allowed only after a VERIFIED non-execution (never after an unverified network error)
PURCHASE_RETRIES_AFTER_VERIFIED_FAILURE=1
PURCHASE_CHECK_BALANCE=true
PURCHASE_WORKERS=2
PROCESSOR_WORKERS=2

# ---------------------------------------------------------------- Discount methodology
DISCOUNT_WINDOW_DAYS=7
DISCOUNT_MIN_SAMPLES=5

# ---------------------------------------------------------------- Notifications
NOTIFY_DEFAULT_MAX_PER_MINUTE=20
TELEGRAM_GLOBAL_MESSAGES_PER_SECOND=25
# Flood protection for incoming button presses / messages per user
BOT_FLOOD_MAX_EVENTS=15
BOT_FLOOD_WINDOW_SECONDS=5

# ---------------------------------------------------------------- Observability
METRICS_HOST=0.0.0.0
METRICS_PORT=9100
LOG_LEVEL=INFO
LOG_FORMAT=json
