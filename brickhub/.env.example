# Скопіюйте у .env і заповніть. Файл .env не потрапляє в git.

# --- Django ---
DJANGO_DEBUG=1                       # 0 на робочому сервері
DJANGO_SECRET_KEY=                   # обов'язково для DJANGO_DEBUG=0: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=         # напр. https://brickhub.com.ua
# DATABASE_URL=postgres://user:password@localhost:5432/brickhub   # без цього — SQLite (db.sqlite3)
# DJANGO_HSTS_SECONDS=31536000       # увімкніть після перевірки HTTPS

# --- Магазин ---
SHOP_NAME=BRICK HUB
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_SITE_URL=http://localhost:8000
SHOP_FREE_DELIVERY_FROM=2500         # 0 — вимкнути безкоштовну доставку
SHOP_ORDER_NOTIFY_EMAILS=            # куди слати листи про нові замовлення (через кому)

# --- Пошта (SMTP). Без EMAIL_HOST листи друкуються в консоль ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BRICK HUB <noreply@example.com>

# --- Нова пошта: пошук міст і відділень, відстеження ТТН ---
NOVA_POSHTA_API_KEY=

# --- Укрпошта: відстеження ---
UKRPOSHTA_BEARER_TOKEN=

# --- LiqPay: оплата карткою (без ключів оплата карткою вимкнена) ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1                     # 0 — реальні платежі
