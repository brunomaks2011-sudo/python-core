# ═══════════════════════════════════════════════════════════════════
#  Налаштування Telegram-бота магазину LEGO
#  Скопіюйте цей файл у .env і заповніть значення:  cp .env.example .env
#  НІКОЛИ не публікуйте .env (токени та паролі) — він уже в .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ─── Telegram ───────────────────────────────────────────────────────
# Токен бота від @BotFather (формат 123456789:AA...)
BOT_TOKEN=
# Telegram ID власника/адміністраторів через кому (дізнатися свій ID: @userinfobot)
ADMIN_IDS=123456789

# ─── База даних PostgreSQL ──────────────────────────────────────────
# Локальний запуск (без Docker):
DATABASE_URL=postgresql://lego:change_me_strong_password@localhost:5432/lego_shop?schema=public
DATABASE_POOL_SIZE=10

# Для docker compose (база в контейнері «db»; DATABASE_URL для бота формується автоматично).
# Пароль — лише латинські літери й цифри, щоб не довелося екранувати його в URL.
POSTGRES_DB=lego_shop
POSTGRES_USER=lego
POSTGRES_PASSWORD=change_me_strong_password

# ─── Claude API (розуміння звичайної мови) ──────────────────────────
# Ключ із https://console.anthropic.com → API Keys. Без ключа бот працює
# з вбудованим резервним розбором повідомлень (без ШІ).
ANTHROPIC_API_KEY=
AI_ENABLED=true
# Модель і рівень «зусиль» (low — швидко й дешевше; medium/high — ретельніше)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=16000
CLAUDE_TIMEOUT_MS=90000
CLAUDE_MAX_ITERATIONS=5
# Автоматичний повтор на резервній моделі, якщо запит відхилено фільтрами безпеки
CLAUDE_SERVER_FALLBACKS=true
# Захист від надмірних витрат: ліміти запитів до ШІ на одного покупця
AI_MAX_REQUESTS_PER_MINUTE=8
AI_MAX_REQUESTS_PER_DAY=200
AI_MAX_CONCURRENCY=4
AI_MAX_MESSAGE_LENGTH=1000

# ─── Магазин ────────────────────────────────────────────────────────
SHOP_NAME=LEGO Shop
# Як зв'язатися з продавцем (показується покупцям)
SHOP_CONTACT=@your_manager, +380 67 000 00 00
SHOP_WORKING_HOURS=Приймаємо замовлення в боті цілодобово. Менеджер відповідає щодня з 9:00 до 20:00.
SHOP_DELIVERY_INFO=Відправляємо Новою поштою та Укрпоштою по всій Україні протягом 1–2 робочих днів. Вартість доставки — за тарифами перевізника.
SHOP_PAYMENT_INFO=Можна оплатити при отриманні (накладений платіж) або переказом на картку після підтвердження замовлення.
# Доступні способи оплати: CASH_ON_DELIVERY, CARD_TRANSFER, BANK_TRANSFER
PAYMENT_METHODS=CASH_ON_DELIVERY,CARD_TRANSFER
# Реквізити, які покупець отримає після підтвердження замовлення (для передоплати).
# Перенос рядка — \n
PAYMENT_DETAILS=Картка ПриватБанку: 0000 0000 0000 0000\nОтримувач: ФОП Іваненко І. І.
DELIVERY_HINT=Вкажіть номер відділення чи поштомату Нової пошти (наприклад: «Відділення №12») або адресу відділення Укрпошти з індексом.
MAX_QUANTITY_PER_ORDER=10
# Поріг «залишилося мало» для нових товарів (можна змінити для кожного товару)
DEFAULT_LOW_STOCK_THRESHOLD=2
TIMEZONE=Europe/Kyiv

# ─── Зберігання даних ───────────────────────────────────────────────
# Скільки днів зберігати історію повідомлень (контекст для «цей набір»)
CHAT_HISTORY_RETENTION_DAYS=30
# Через скільки годин незавершене оформлення вважається покинутим
CHECKOUT_TTL_HOURS=72

# ─── Режим роботи ───────────────────────────────────────────────────
# За замовчуванням — long polling (не потрібні домен і HTTPS).
# Для webhook вкажіть домен із HTTPS (reverse proxy → WEBHOOK_PORT):
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_PORT=8443
# Секрет для перевірки, що запити надходять саме від Telegram (16–256 символів A-Z a-z 0-9 _ -)
WEBHOOK_SECRET_TOKEN=
# Порт перевірки стану (GET /health) — для моніторингу та Docker
HEALTH_PORT=8080
# Власний сервер Telegram Bot API (зазвичай не потрібен)
TELEGRAM_API_ROOT=

# ─── Інше ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_PRETTY=true — читабельні логи під час розробки
LOG_PRETTY=false
BROADCAST_MESSAGES_PER_SECOND=20
# Резервні копії (docker compose / scripts/backup.sh)
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
